{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Postgres": {
    "ConnectionString": "Host=localhost;Port=5434;Database=lintty_dev;Username=lintty;Password=lintty_dev;Include Error Detail=true"
  },
  "JobStorage": {
    "Root": "var/lintty"
  },
  "Engine": {
    "CliDllPath": null,
    "JobTimeoutSeconds": 900,
    "CloneTimeoutSeconds": 120
  },
  "RateLimit": {
    "JobsPerIpPerDay": 0
  },
  "Queue": {
    "MaxLength": 5,
    "PollIntervalMs": 500
  }
}
