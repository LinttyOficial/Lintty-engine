<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.11.0" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.7.8" />
    <PackageVersion Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageVersion Include="YamlDotNet" Version="16.1.3" />
    <PackageVersion Include="QuestPDF" Version="2024.7.3" />
    <!--
      Postgres backing store for the Web Inspector (ADR 0007 Sprint 1). Npgsql
      pure + Dapper instead of EF Core: the IJobStore surface is small and
      hand-written SQL (UPDATE...RETURNING, ON CONFLICT DO UPDATE) is more
      direct than EF query translation. EF Core enters in Sprint 2 alongside
      Identity (UserStore<TUser> requires it) — at that point both stacks
      coexist on the same Postgres connection: EF for Identity tables,
      Npgsql/Dapper for the Lintty domain.
    -->
    <PackageVersion Include="Npgsql" Version="8.0.5" />
    <PackageVersion Include="Dapper" Version="2.1.35" />
    <!--
      ADR 0007 Sprint 2 — EF Core enters alongside ASP.NET Identity. Coexists
      with Dapper on the same Postgres instance: EF owns the schema (Identity
      + multi-tenant: users/orgs/org_members/external_logins/jobs/rate_limits),
      Dapper still drives the hot path in PostgresJobStore (UPDATE...RETURNING
      with FOR UPDATE SKIP LOCKED in ClaimNextQueuedAsync). Coexistence is the
      canonical .NET pattern; both stacks read/write through the same Npgsql
      connection pool.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.10" />
    <PackageVersion Include="EFCore.NamingConventions" Version="8.0.3" />
    <!--
      Community OAuth handler for GitHub. Microsoft ships handlers for
      Google/Microsoft/Twitter; the GitHub one lives in this package. Only
      pulls in System.Net.Http + the AuthenticationHandler — no extra deps.
    -->
    <PackageVersion Include="AspNet.Security.OAuth.GitHub" Version="8.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.10" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageVersion Include="xunit" Version="2.9.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!--
      Testcontainers boots an ephemeral Postgres 16 container per test class
      so the full V0 suite (17 tests) and the cross-determinism gate
      (WorkerIntegrationTests) run against the same backing store as prod.
      Single Postgres shared across tests would create flakiness (rate_limits
      table, jobs schema reset between fixtures).
    -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="3.10.0" />
  </ItemGroup>
</Project>
